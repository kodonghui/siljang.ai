{
  "name": "@siljang/web",
  "private": true,
  "description": "사장님·운영자 웹(React·Vite). 빌드(dist/)는 서버 Worker가 정적 자산으로 준다. API는 src/api.ts 한 곳에서만 부른다.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && node scripts/check-dist.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "check:pages": "node scripts/page-check.mjs",
    "check:pwa": "node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "vite": "8.3.6",
    "yaml": "2.9.1"
  }
}
