# 로컬 개발(wrangler dev)에서 읽는 값의 이름. 이 파일을 .dev.vars로 복사해 값을 채운다.
# .dev.vars는 저장소에 넣지 않는다(.gitignore). 이 예시 파일에는 값을 적지 않는다.
# 배포한 Worker의 비밀 값은 `wrangler secret put <이름>`으로만 넣는다.

# 실행 환경 이름: development | staging | production. 비우면 production으로 친다.
APP_ENV=development

# AI 모델 키(비밀 값). 서버만 읽고, 웹 빌드(VITE_*)에는 절대 넣지 않는다. 없으면 AI 일만 503 ai_unavailable(TASK-026에서).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PostgreSQL 연결 문자열(비밀 값). postgres:// 나 postgresql:// 로 시작. Workers에서는 Hyperdrive 바인딩(TASK-173).
# 없으면 데이터베이스가 필요한 요청만 500 internal.
DATABASE_URL=

# 요청 지문(request_keys.request_hash)을 만드는 HMAC-SHA256 키(비밀 값, 32자 이상). 없으면 쓰기 명령이 500 internal.
REQUEST_HASH_KEY=

# 사진 저장소(TASK-022): Supabase Storage의 S3 호환 주소와 S3 접근 키. Supabase publishable·secret 키가 아니다(TASK-174).
# 주소는 https만(development에서만 http://localhost·127.0.0.1). 세 주소 값은 함께 넣거나 함께 비운다.
# 없으면 사진 올리기·사진 주소만 500 internal.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# 사진의 15분 서명 주소 키(비밀 값, 32자 이상). 없으면 사진 주소를 내는 요청과 사진 주소만 500 internal.
FILE_URL_KEY=

# 계좌번호·원래 값 암호화(TASK-025, 05 E20): 버전마다 무작위 32바이트의 base64url(43자) 비밀 값과 새로 쓸 때의 버전.
# 키는 app/README.md 31의 명령으로 만들어 바로 넣는다(값을 화면·대화·저장소에 남기지 않음). 사본은 비밀 저장소에 둔다
# (키를 잃으면 계좌번호를 되살릴 수 없음). 없으면 계좌번호·마스킹한 원래 값을 쓰거나 보는 요청만 500 internal.
FIELD_KEY_CURRENT=
FIELD_KEY_V1=
