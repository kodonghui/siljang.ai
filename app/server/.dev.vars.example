# 로컬 개발(wrangler dev)에서 읽는 값의 이름. 이 파일을 .dev.vars로 복사해 값을 채운다.
# .dev.vars는 저장소에 넣지 않는다(.gitignore). 이 예시 파일에는 값을 적지 않는다.
# 배포한 Worker의 비밀 값은 `wrangler secret put <이름>`으로만 넣는다.

# 실행 환경 이름: development | staging | production. 비우면 production으로 친다.
APP_ENV=development

# AI 모델 키(비밀 값). 서버만 읽고, 웹 빌드(VITE_*)에는 절대 넣지 않는다. AI_PROVIDER로 고른 회사의 키만 쓴다.
# 고른 회사의 키가 없으면 모델 호출마다 ai_calls에 key_missing 한 행을 남기고 부르지 않는다(06 DEC-07 ai_key_missing, TASK-026).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 모델 호출 설정(TASK-026, app/README.md 48~57). 다섯 값을 모두 비우면 모델 호출만 설정 없음(부르면 500 internal).
# AI_PROVIDER: anthropic | openai. AI_MODEL: 그 회사의 요금표(server/src/ai-prices.ts)에 있는 모델 ID만.
# AI_EFFORT: low | medium | high, 비우면 모델 기본. AI_USD_KRW: 원/달러 환율(예 1450.25), AI_USD_KRW_DATE: 그 환율의 날짜(YYYY-MM-DD).
AI_PROVIDER=
AI_MODEL=
AI_EFFORT=
AI_USD_KRW=
AI_USD_KRW_DATE=

# 추적 도구(LangSmith)는 운영(APP_ENV=production)에서 켜면 시작에서 멈춘다(REQ-138): LANGSMITH_TRACING·LANGSMITH_TRACING_V2·
# LANGCHAIN_TRACING_V2·LANGCHAIN_TRACING·LANGCHAIN_VERBOSE·LANGSMITH_GATEWAY는 비우거나 false, LANGSMITH_API_KEY·
# LANGCHAIN_API_KEY·LANGSMITH_GATEWAY_API_KEY는 두지 않는다. 로컬 개발에서만 켤 수 있다(합성 대화로만).

# PostgreSQL 연결 문자열(비밀 값). postgres:// 나 postgresql:// 로 시작. Workers에서는 Hyperdrive 바인딩(TASK-173).
# 없으면 데이터베이스가 필요한 요청만 500 internal.
DATABASE_URL=

# 요청 지문(request_keys.request_hash)을 만드는 HMAC-SHA256 키(비밀 값, 32자 이상). 없으면 쓰기 명령이 500 internal.
REQUEST_HASH_KEY=

# 사진 저장소(TASK-022): Supabase Storage의 S3 호환 주소와 S3 접근 키. Supabase publishable·secret 키가 아니다(TASK-174).
# 주소는 https만(development에서만 http://localhost·127.0.0.1). 세 주소 값은 함께 넣거나 함께 비운다.
# 없으면 사진 올리기·사진 주소만 500 internal.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# 사진의 15분 서명 주소 키(비밀 값, 32자 이상). 없으면 사진 주소를 내는 요청과 사진 주소만 500 internal.
FILE_URL_KEY=

# 계좌번호·원래 값 암호화(TASK-025, 05 E20): 버전마다 무작위 32바이트의 base64url(43자) 비밀 값과 새로 쓸 때의 버전.
# 키는 app/README.md 31의 명령으로 만들어 바로 넣는다(값을 화면·대화·저장소에 남기지 않음). 사본은 비밀 저장소에 둔다
# (키를 잃으면 계좌번호를 되살릴 수 없음). 없으면 계좌번호·마스킹한 원래 값을 쓰거나 보는 요청만 500 internal.
FIELD_KEY_CURRENT=
FIELD_KEY_V1=

# TASK-020 사장님 카카오 로그인. URI 목록은 쉼표로 구분한 정확한 https 주소.
# 동의 항목은 쉼표로 구분하며 MVP는 빈 값(scope 생략). plusfriends를 명시한 때만 채널 조회/기록/배너를 켠다.
# 채널 ID는 plusfriends를 켰을 때 필요하고, Admin 키는 그때 친구 여부 재조회에만 사용한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_OWNER_REDIRECT_URIS=
KAKAO_OWNER_LOGIN_SCOPES=
KAKAO_ALERT_CHANNEL_ID=
