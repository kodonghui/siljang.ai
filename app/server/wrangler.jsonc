// Cloudflare Worker 설정(TASK-015 뼈대). 계정 ID·도메인·비밀 값은 여기에 적지 않는다.
// - 계정은 배포할 때 환경 변수 CLOUDFLARE_ACCOUNT_ID·CLOUDFLARE_API_TOKEN으로 고른다(동희님 TASK-170 뒤).
// - 비밀 값(ANTHROPIC_API_KEY·OPENAI_API_KEY 등)은 `wrangler secret put`, 로컬은 .dev.vars(저장소에 넣지 않음).
// - /api/* 만 Worker가 받고, 나머지 주소는 웹 빌드(../web/dist)의 정적 파일이다. 없는 화면 주소는 index.html(화면 라우팅은 웹이 함).
// - TASK-173의 Hyperdrive·Cron Trigger·Placement는 staging에 둔다. AI 콜백 큐는 처리기와 함께 붙인다.
// - nodejs_compat(데이터베이스 드라이버 pg가 씀)은 따로 적지 않는다. 호환 날짜가 2026-08-04 이후면 기본으로 켜진다
//   (Cloudflare Hyperdrive 문서, 2026-11-15 확인, app/README.md 12).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "siljang",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  "services": [{ "binding": "STORAGE_BATCHES", "service": "siljang-storage-batches", "entrypoint": "StorageBatches" }],
  "images": { "binding": "IMAGES" },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // 사진 올리기의 사장님마다 1분 30번(06 DEC-16, TASK-022). 값은 src/rate-limit.ts의 UPLOAD_RATE와 같아야 한다(시험이 봄).
  // namespace_id는 이 계정 안에서 한도를 나누는 번호다. 한도는 대략이고 Cloudflare 위치마다 센다
  // (Cloudflare 문서 'Rate Limiting', 2026-11-16 확인, app/README.md 24).
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "OWNER_LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    { "name": "PUBLIC_PRIVACY_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "PUBLIC_BOOKING_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "FILE_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } }
  ],
  "env": {
    "staging": {
      "vars": { "APP_ENV": "staging" },
      "services": [
        {
          "binding": "STORAGE_BATCHES",
          "service": "siljang-storage-batches-staging",
          "entrypoint": "StorageBatches"
        }
      ],
      "images": { "binding": "IMAGES" },
      "placement": { "region": "aws:ap-northeast-2" },
      "triggers": { "crons": ["* * * * *"] },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "822c6fce48714d8498b4e6098f0654db" }],
      "queues": {
        "producers": [{ "binding": "KAKAO_CALLBACK_QUEUE", "queue": "siljang-staging-kakao-callbacks" }],
        "consumers": [
          {
            "queue": "siljang-staging-kakao-callbacks",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "dead_letter_queue": "siljang-staging-kakao-callbacks-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "OWNER_LOGIN_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 }
        },
        { "name": "PUBLIC_PRIVACY_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLIC_BOOKING_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
        { "name": "FILE_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } }
      ]
    }
  }
}
