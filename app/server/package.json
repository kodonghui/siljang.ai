{
  "name": "@siljang/server",
  "private": true,
  "description": "사장님·운영자 API와 카카오 스킬을 받는 Cloudflare Worker(Hono). 웹 빌드(../web/dist)를 같은 Worker의 정적 자산으로 준다.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --include-env=false src/worker-runtime.d.ts",
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler deploy --dry-run --config wrangler.storage-batches.jsonc --outdir dist/storage-batches",
    "eval": "node --disable-warning=ExperimentalWarning --import ./eval/register.mjs eval/cli.ts",
    "eval:checklist": "node --disable-warning=ExperimentalWarning --import ./eval/register.mjs eval/cli.ts --checklist",
    "operator:enroll": "node --disable-warning=ExperimentalWarning --import ./eval/register.mjs tools/operator-enroll-cli.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@langchain/anthropic": "1.6.1",
    "@langchain/core": "1.3.5",
    "@langchain/openai": "1.8.2",
    "aws4fetch": "1.0.20",
    "hono": "4.13.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exifreader": "4.54.0",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  }
}
